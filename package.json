{
  "name": "dtf-index-subgraph",
  "license": "UNLICENSED",
  "version": "1.11.0",
  "scripts": {
    "codegen": "graph codegen",
    "build": "graph build",
    "create-local": "graph create --node http://localhost:8020/ dtf-index-subgraph",
    "remove-local": "graph remove --node http://localhost:8020/ dtf-index-subgraph",
    "deploy-local": "graph deploy --node http://localhost:8020/ --ipfs http://localhost:5001 dtf-index-subgraph",
    "prepare:fork": "node scripts/prepare-mainnet-fork.js",
    "parse:fork": "node scripts/parse-template.js --network mainnet --config .fork/networks.json --output subgraph.fork.yaml",
    "codegen:fork": "graph codegen subgraph.fork.yaml",
    "build:fork": "graph build subgraph.fork.yaml",
    "create-local:fork": "graph create --node ${FORK_GRAPH_NODE_ADMIN_URL:-http://localhost:18020/} dtf-index-subgraph-fork",
    "remove-local:fork": "graph remove --node ${FORK_GRAPH_NODE_ADMIN_URL:-http://localhost:18020/} dtf-index-subgraph-fork",
    "deploy-local:fork": "graph deploy --node ${FORK_GRAPH_NODE_ADMIN_URL:-http://localhost:18020/} --ipfs ${FORK_IPFS_URL:-http://localhost:15001} --version-label fork dtf-index-subgraph-fork subgraph.fork.yaml",
    "test:fork:parity": "node scripts/check-fork-parity.js",
    "test:fork:parity:offline": "node --test scripts/check-fork-parity.test.js",
    "test": "graph test",
    "parse:mainnet": "node scripts/parse-template.js --network mainnet",
    "parse:base": "node scripts/parse-template.js --network base",
    "parse:bsc": "node scripts/parse-template.js --network bsc",
    "deploy:mainnet": "node scripts/deploy.js --network mainnet",
    "deploy:base": "node scripts/deploy.js --network base",
    "deploy:bsc": "node scripts/deploy.js --network bsc",
    "deploy:all": "node scripts/deploy-all.js",
    "deploy": "node scripts/deploy-interactive.js"
  },
  "dependencies": {
    "@graphprotocol/graph-cli": "0.91.1",
    "@graphprotocol/graph-ts": "0.35.1"
  },
  "devDependencies": {
    "matchstick-as": "0.6.0",
    "mustache": "^4.2.0"
  }
}
